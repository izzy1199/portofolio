name: CI

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Ambil kode
        uses: actions/checkout@v4

      - name: Build Docker image
        run: docker build -t portofolio .

      - name: Tes container jalan
        run: |
          docker run -d -p 8080:80 --name portofolio portofolio
          sleep 3
          curl -f http://localhost:8080